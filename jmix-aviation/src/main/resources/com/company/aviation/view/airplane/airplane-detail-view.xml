<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://airplaneDetailView.title"
      focusComponent="form">
    <data>
        <instance id="airplaneDc"
                  class="com.company.aviation.entity.Airplane">
            <fetchPlan extends="_base">
                <property name="airport" fetchPlan="_base"/>
                <property name="flights" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
        <collection id="airportsDc"
                    class="com.company.aviation.entity.Airport">
            <fetchPlan extends="_base"/>
            <loader id="airportsDl">
                <query>
                    <![CDATA[select e from Airport e order by e.name]]>
                </query>
            </loader>
        </collection>
        <collection id="flightsDc"
                    class="com.company.aviation.entity.Flight">
            <fetchPlan extends="_base"/>
            <loader id="flightsDl">
                <query>
                    <![CDATA[select f from Flight f
                    where (:airportId is not null and f.airport.id = :airportId)
                    order by f.arrivalPoint]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <formLayout id="form" dataContainer="airplaneDc">
            <textField id="manufacturerField" property="manufacturer"/>
            <textField id="boardNumberField" property="boardNumber"/>
            <typedTextField id="payloadCapacityField" property="payloadCapacity" datatype="double"/>
            <datePicker id="commissioningDateField" property="commissioningDate"/>
            <entityComboBox id="airportField" property="airport" itemsContainer="airportsDc"/>
            <multiSelectComboBox id="flightsField" property="flights" itemsContainer="flightsDc"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
